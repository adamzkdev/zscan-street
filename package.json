{
  "name": "zscan-street-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3007",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3007",
    "start": "node server.mjs",
    "build:cloudflare": "tsc --noEmit && vite build",
    "deploy:cloudflare": "cf deploy --prebuilt",
    "check:worker": "cf workers types && tsc --noEmit -p tsconfig.worker.json",
    "rooms": "node server/rooms/main.ts",
    "rooms:test": "node server/rooms/test.ts"
  },
  "dependencies": {
    "@noir-wallet/sdk": "^0.1.9",
    "qrcode": "^1.5.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.16",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.186.0",
    "cf": "^1.0.0-beta.31",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
